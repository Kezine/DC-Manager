{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-test",
    "noEmit": false,
    "sourceMap": false
  },
  "include": [
    "src-client/**/*.ts", "src-shared/**/*.ts",
    // Modules SERVEUR testables sans Express (tests dans Tests/modules/run.js, driver SQLite injecté) :
    // ApiRules (règles pures de la couche HTTP), Repository/db et DocumentStore (+ constants/logger transitifs).
    "src-server/src/ApiRules.ts", "src-server/src/db.ts", "src-server/src/documents.ts",
    // Repository RELATIONNEL (lot L2 migration DB) — chemin de PRODUCTION depuis la bascule L4 : testé
    // avec better-sqlite3 RÉEL (le shim des tests blob ne parle pas ce SQL).
    "src-server/src/RelationalRepository.ts",
    // Migration LEGACY blob → relationnel au boot d'un document (lot L4) — backup .bak, transaction
    // unique, abort nommant le record fautif : testée avec better-sqlite3 RÉEL sur fichiers temporaires.
    "src-server/src/LegacyMigration.ts",
    // Module `vm/` AMOVIBLE — parsing Proxmox PUR (aucun réseau/Node) : testé en isolation
    // (fixtures JSON → VmRecord). Seul ce fichier est émis dans dist-test/ ; VmProvider.ts n'est
    // qu'un import de TYPES (erased), pas de dépendance runtime.
    "src-server/src/vm/ProxmoxParse.ts",
    // Validation PAR PROVIDER (classe PURE) — messages d'erreur uniques, testée en isolation
    // (parseProvider + libellés) ; l'import `../logger.js` (transitif) est déjà compilé via documents.ts.
    "src-server/src/vm/ProviderConfigValidate.ts",
    // Stockage DB des providers (vm-providers.db, jetons chiffrés via SecretBox) — UNIQUE source de
    // config : CRUD + lecture pour la synchro ; testé avec better-sqlite3 RÉEL (driver injecté).
    "src-server/src/vm/ProviderConfigDb.ts",
    // Adaptateur Proxmox — l'ORCHESTRATION est testée avec un client HTTP stub (PveJsonClient
    // injecté) ; PveHttp (node:https) est compilé transitivement mais jamais sollicité en test.
    "src-server/src/vm/ProxmoxAdapter.ts",
    // Moteur de réconciliation PUR (inventaire pivot → ops create/update/orphan) — dépendances
    // injectées (résolution d'hôte, id, horloge) ; la frontière source/locaux vient de src-shared/VmSync.
    "src-server/src/vm/VmReconcile.ts",
    // Moteur de SYNCHRO (adaptateur → réconciliation → écriture transactionnelle + SSE) — sans Express
    // (bus live vu par interface, adaptateur injecté) : testé avec DocumentStore réel + stub d'inventaire.
    // Les routes (VmModule.ts, Express) restent HORS test, comme api.ts.
    "src-server/src/vm/VmSyncService.ts",
    // Enrichissement PUR des statuts (réinjecte les providers au jeton indéchiffrable, exclus par
    // providersFor, comme statuts en erreur) — logique sans DB/réseau, testée en isolation.
    "src-server/src/vm/VmStatusEnrichment.ts",
    // Module `wifi/` AMOVIBLE (clients wifi synchronisés depuis un contrôleur — UniFi en 1re
    // implémentation, la marque n'étant qu'un adaptateur derrière `kind`, cf. docs/wifi-unifi.md).
    // Décodage UniFi PUR (fixtures JSON → WifiClientRecord) + logique de PAGINATION pure (premier
    // précédent de pagination sortante du dépôt) : testés en isolation, sans réseau.
    "src-server/src/wifi/UnifiParse.ts",
    // Client HTTPS UniFi : seules ses parties PURES sont sollicitées en test (trustOptions —
    // hiérarchie épinglage/CA/système — et explainNetworkError) ; `node:https` est compilé mais
    // jamais appelé, exactement comme PveHttp côté vm/.
    "src-server/src/wifi/UnifiHttp.ts",
    // Adaptateur UniFi — l'ORCHESTRATION (résolution de site, index des AP au mieux, pagination,
    // filtre filaire) est testée avec un client HTTP stub (`UnifiJsonClient` injecté).
    "src-server/src/wifi/UnifiAdapter.ts",
    // Validation PAR PROVIDER (classe PURE) : champs COMMUNS + branche d'options par `kind` —
    // c'est le point d'extension « nouvelle marque » côté validation, donc testé pour lui-même.
    "src-server/src/wifi/WifiProviderConfigValidate.ts",
    // Stockage DB des providers (wifi-providers.db, jetons chiffrés via SecretBox, table UNIQUE) :
    // CRUD + lecture pour la synchro ; testé avec better-sqlite3 RÉEL (driver injecté).
    "src-server/src/wifi/WifiProviderConfigDb.ts",
    // Moteur de réconciliation PUR (inventaire pivot → ops create/update/déconnexion) — dépendances
    // injectées (résolution d'AP, id, horloge) ; la frontière source/locaux vient de src-shared/WifiSync.
    "src-server/src/wifi/WifiReconcile.ts",
    // Moteur de SYNCHRO (adaptateur → réconciliation → écriture transactionnelle + SSE) — sans
    // Express : testé avec DocumentStore réel + stub d'inventaire. Les routes (WifiModule.ts,
    // Express) restent HORS test, comme api.ts et VmModule.
    "src-server/src/wifi/WifiSyncService.ts",
    // Module `issues/` AMOVIBLE (« remote issue tracker » : miroir des tickets SUIVIS d'un tracker
    // distant — Atlassian Jira Cloud en 1re implémentation, la marque n'étant qu'un adaptateur
    // derrière `kind`). ⚠ Assiette INVERSÉE par rapport à vm/ et wifi/ : c'est le DOCUMENT qui
    // énumère, et l'adaptateur RÉSOUT (`resolve(extIds)`), d'où un pivot testé pour son ÉGALITÉ avec
    // la frontière partagée src-shared/IssueSync.
    // Contrats purs (pivot + adaptateur + config) : aucun runtime hors la liste canonique des champs
    // du pivot, qui est justement ce que le test d'invariant compare au partagé.
    "src-server/src/issues/IssueProvider.ts",
    // Validation PAR PROVIDER (classe PURE) : champs COMMUNS + branche d'options par `kind` — c'est
    // le point d'extension « nouvelle marque » côté validation, donc testé pour lui-même.
    "src-server/src/issues/IssueProviderConfigValidate.ts",
    // Stockage DB des providers (issue-providers.db, jetons chiffrés via SecretBox, table UNIQUE et
    // SANS matériel TLS — un tracker SaaS a un certificat public) : CRUD + lecture pour la synchro ;
    // testé avec better-sqlite3 RÉEL (driver injecté).
    "src-server/src/issues/IssueProviderConfigDb.ts",
    // Décodage Jira PUR (fixtures JSON → IssueRecord, alias de champs, catégorie d'état, lien
    // d'INTERFACE composé — jamais `self`, ADF de création) + pagination pure TOLÉRANTE aux DEUX
    // formes d'API (jeton `nextPageToken` / décalage `startAt`) : testés en isolation, sans réseau.
    "src-server/src/issues/JiraParse.ts",
    // Client HTTP Jira : `fetch` INJECTÉ (patron notify/WebhookNotifier, PAS le node:https de
    // vm//wifi/ — cf. l'écart documenté dans le fichier), donc TOUT y est testable sans réseau,
    // parties pures comprises (en-tête Basic, `Retry-After`, extraction du message d'erreur Jira).
    "src-server/src/issues/JiraHttp.ts",
    // Adaptateur Jira — l'ORCHESTRATION (résolution PAR LOTS, pagination, création + ADF, test de
    // connexion) est testée avec un client HTTP stub (`JiraJsonClient` injecté).
    "src-server/src/issues/JiraAdapter.ts",
    // Coffre à secrets serveur PARTAGÉ (AES-256-GCM, node:crypto) des secrets stockés en DB
    // (jetons providers VM, jetons webhooks notify) — testé en isolation (aller-retour, clé
    // différente, altération, format inconnu, repli d'environnement legacy).
    "src-server/src/SecretBox.ts",
    // Module `notify/` AMOVIBLE — moteur anti-spam PUR (état/routage/horloge/journal injectés) :
    // testé en isolation (nouveau/rappel dû-pas dû/resolve avec-sans envoi/échec d'envoi/multi-types).
    "src-server/src/notify/NotifyEngine.ts",
    "src-server/src/notify/MemoryNotifyStateStore.ts",
    "src-server/src/notify/ConsoleNotifier.ts",
    // Persistance du module notify (notify.db : instances/abonnements/états/log/réglages) —
    // testée avec better-sqlite3 RÉEL (driver injecté), validation pure NotifyValidate,
    // webhook avec fetch INJECTÉ (payload/en-tête/erreurs sans secret), routage des abonnements
    // (contacts vus par contrat ContactSource — stub en test).
    "src-server/src/notify/NotifyValidate.ts",
    "src-server/src/notify/NotifyDb.ts",
    // Formatage PUR du corps des webhooks (texte compact / HTML échappé / brut) — testé en isolation.
    "src-server/src/notify/WebhookFormat.ts",
    "src-server/src/notify/WebhookNotifier.ts",
    "src-server/src/notify/SubscriptionRouter.ts",
    // Module `certs/` AMOVIBLE (PKI zéro-connaissance) — persistance certs.db (3 vraies tables,
    // FK composite émetteur, SAN ordonnés) + validation pure : testés avec better-sqlite3 RÉEL.
    // Les routes (CertsModule.ts, Express) restent HORS test, comme api.ts/VmModule/NotifyModule.
    "src-server/src/certs/CertsValidate.ts",
    "src-server/src/certs/CertsDb.ts",
    // Veilleur d'échéances (producteur cert-expiry, seuils Q6 30/14/7 j) — PUR (source/rapporteur/
    // horloge injectés), testé avec stubs + horloge contrôlée.
    "src-server/src/certs/CertExpiryWatcher.ts",
    // Module `interventions/` AMOVIBLE (incidents/interventions liés aux équipements/VMs/spares) —
    // validation PURE (enums + griefs groupés + normalisation JIRA_BASE_URL) et persistance
    // interventions.db (2 tables, liens ordonnés + cascade, listing paginé) : testées avec
    // better-sqlite3 RÉEL. Les routes (InterventionsModule.ts, Express) restent HORS test, comme
    // api.ts/VmModule/NotifyModule/CertsModule.
    "src-server/src/interventions/InterventionsValidate.ts",
    "src-server/src/interventions/InterventionsDb.ts",
    // Veilleur de rappels (producteur intervention-reminder, paliers 24 h/1 h/heure H) — PUR
    // (source/rapporteur/horloge/seuils injectés), testé avec stubs + horloge contrôlée.
    "src-server/src/interventions/InterventionReminderWatcher.ts",
    // Annuaire utilisateurs (service CORE) — logique PURE (UserProfiles : clé canonique, normalisation,
    // caviardage, parsing d'ids) + impl v1 (AuthCacheUserResolver : cache mémoire + capture) testée SANS
    // SQLite (db null) + snapshot (UsersDb, users.db 1 table typée) testé avec better-sqlite3 RÉEL (driver
    // injecté). UserResolver.ts (types seuls) est tiré transitivement. auth.ts/api.ts restent HORS test.
    "src-server/src/users/UserProfiles.ts",
    "src-server/src/users/UsersDb.ts",
    "src-server/src/users/AuthCacheUserResolver.ts"
  ]
}
